{
  "verses": [
    {
      "verse": 1,
      "text": "هللويا. سبحوا الله في قدسه. سبحوه في فلك قوته‎."
    },
    {
      "verse": 2,
      "text": "‎سبحوه على قواته سبحوه حسب كثرة عظمته‎."
    },
    {
      "verse": 3,
      "text": "‎سبحوه بصوت الصور سبحوه برباب وعود‎."
    },
    {
      "verse": 4,
      "text": "‎سبحوه بدف ورقص. سبحوه باوتار ومزمار‎."
    },
    {
      "verse": 5,
      "text": "‎سبحوه بصنوج التصويت سبحوه بصنوج الهتاف‎."
    },
    {
      "verse": 6,
      "text": "‎كل نسمة فلتسبح الرب. هللويا"
    }
  ]
}